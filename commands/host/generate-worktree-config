#!/usr/bin/env bash

#ddev-generated
## Description: Generate all worktree-specific DDEV and TYPO3 site configuration.
## Usage: generate-worktree-config [worktree-folder] [flags]
## Example: "ddev generate-worktree-config my-folder"
## Flags: [{"Name":"delete","Shorthand":"d","Usage":"remove generated worktree configuration files"}]
## MutagenSync: true
#

set -euo pipefail

# identify TYPO3 folder using composer_root setting
DDEV_TYPO3_ROOT=$DDEV_APPROOT/$(awk '/^[:space:]*composer_root/ {print $2}' $DDEV_APPROOT/.ddev/config.yaml)
DDEV_TYPO3_ROOT=${DDEV_TYPO3_ROOT%/}

command_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ "${1:-}" == "--delete" || "${1:-}" == "-d" ]]; then
	rm -f "$DDEV_APPROOT/.ddev/config.local.yaml" "$DDEV_TYPO3_ROOT"/config/sites/*/config.worktree.local.yaml
	printf 'Removed generated worktree configuration files.\n'
	exit 0
fi

# Fix fetch configuration
git config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"

"$command_dir/generate-worktree-ddev-config" "$@"
"$command_dir/generate-worktree-site-config" "$@"
